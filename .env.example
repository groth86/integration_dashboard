# Railway Postgres connection string (use the pooled URL for serverless deploys)
DATABASE_URL="postgresql://user:password@host:port/database"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Password for the initial admin user created by the seed script
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-on-first-login"

# --- External integration-monitor job (npm run monitor) ---
MONITOR_SOURCE="mock"
MONITOR_SOURCE_URL="https://your-integration-platform.example.com/api/events"
MONITOR_SOURCE_TOKEN=""
MONITOR_SINCE_PARAM="since"
MONITOR_SOURCE_ROOT=""
MONITOR_LOOKBACK_HOURS="24"
MONITOR_CREATE_ACCOUNTS="true"
MONITOR_BATCH_SIZE="500"
MONITOR_DRY_RUN="0"
