# Railway Postgres connection string (use the pooled URL for serverless deploys)
DATABASE_URL="postgresql://user:password@host:port/database"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Password for the initial admin user created by the seed script
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me-on-first-login"

# --- Flowgear record import (POST /api/recordimport/fromflowgear) ---
# Secret Flowgear must send as "Authorization: Bearer <token>". The endpoint
# rejects every call (401) until this is set. Generate: openssl rand -hex 32
FLOWGEAR_IMPORT_BEARER_TOKEN=""
# "true": an accountName the dashboard doesn't know yet is created as a new
# account. "false": records for unknown accounts are skipped.
FLOWGEAR_IMPORT_AUTO_CREATE_ACCOUNTS="true"
# Maximum number of records Flowgear may send in one request (larger = 413)
FLOWGEAR_IMPORT_MAX_RECORDS_PER_REQUEST="500"

# --- Payload storage (applies to every way records are written) ---
# Request/response payloads longer than this many characters are cut short
# (with a "[truncated]" marker) before they are stored
PAYLOAD_TRUNCATE_AFTER_CHARS="65536"
# Request/response payloads are cleared this many hours after being stored;
# the record's status, code, description and retry count are kept
PAYLOAD_CLEAR_AFTER_HOURS="24"

# --- Optional pull job (npm run monitor) — not needed when Flowgear pushes ---
MONITOR_SOURCE="mock"
MONITOR_SOURCE_URL="https://your-integration-platform.example.com/api/events"
MONITOR_SOURCE_TOKEN=""
MONITOR_SINCE_PARAM="since"
MONITOR_SOURCE_ROOT=""
MONITOR_LOOKBACK_HOURS="24"
MONITOR_CREATE_ACCOUNTS="true"
MONITOR_BATCH_SIZE="500"
MONITOR_DRY_RUN="0"
